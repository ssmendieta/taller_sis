# =========================================================
# HU ABC-158 - Variables de entorno (sin secretos reales)
# Copiar a .env con: cp .env.example .env
# =========================================================

# Puertos
GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
PRODUCCION_SERVICE_PORT=3002
LOGISTICA_SERVICE_PORT=3003
FRONTEND_PORT=5173

# Entornos
NODE_ENV=development

# URLs servicios (Gateway -> Microservicios)
AUTH_SERVICE_URL=http://localhost:3001
PRODUCCION_SERVICE_URL=http://localhost:3002
LOGISTICA_SERVICE_URL=http://localhost:3003
API_GATEWAY_URL=http://localhost:3000
# Frontend solo conoce el Gateway (VITE_API_URL es alias de API_GATEWAY_URL)
VITE_API_URL=http://localhost:3000

# Base de datos - PostgreSQL 1 instancia taller_postgres:5432
# Placeholders - cambiar en .env real, no versionar secretos
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres_user
DB_PASSWORD=postgres_password_example

# Alias POSTGRES_* (compatibilidad Fase 3) -> mapean a DB_*
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_password_example
POSTGRES_DB=auth_db

# Bases por microservicio (3 DBs en 1 instancia)
DB_AUTH_DATABASE=auth_db
DB_PRODUCCION_DATABASE=produccion_db
DB_LOGISTICA_DATABASE=logistica_db
# Alias Fase 3
AUTH_DB=auth_db
PRODUCCION_DB=produccion_db
LOGISTICA_DB=logistica_db

# JWT (placeholder - sin valor real, se completará en Fase auth)
JWT_SECRET=change_this_secret_example
JWT_EXPIRES_IN=1h

# Flag para pruebas sin PostgreSQL (solo health sin DB). No usar en producción con PG.
SKIP_DB=false
