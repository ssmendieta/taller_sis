# =========================================================
# HU ABC-158 - Variables de entorno (sin secretos reales)
# Copiar a .env con: cp .env.example .env
# =========================================================

# Puertos
GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
PRODUCCION_SERVICE_PORT=3002
LOGISTICA_SERVICE_PORT=3003
FRONTEND_PORT=5173

# Entornos
NODE_ENV=development

# URLs servicios (Gateway -> Microservicios)
# AUTH_SERVICE_URL lo usa produccion-service para validar la sesión (GET /me).
# En local: http://localhost:3001. En docker-compose se fija a http://auth-service:3001.
AUTH_SERVICE_URL=http://localhost:3001
PRODUCCION_SERVICE_URL=http://localhost:3002
LOGISTICA_SERVICE_URL=http://localhost:3003
API_GATEWAY_URL=http://localhost:3000
# Frontend solo conoce el Gateway (VITE_API_URL es alias de API_GATEWAY_URL)
VITE_API_URL=http://localhost:3000

# Base de datos - PostgreSQL 1 instancia taller_postgres:5432
# Placeholders - cambiar en .env real, no versionar secretos
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres_user
DB_PASSWORD=postgres_password_example

# Alias POSTGRES_* (compatibilidad Fase 3) -> mapean a DB_*
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_password_example
POSTGRES_DB=auth_db

# Bases por microservicio (3 DBs en 1 instancia)
DB_AUTH_DATABASE=auth_db
DB_PRODUCCION_DATABASE=produccion_db
DB_LOGISTICA_DATABASE=logistica_db
# Alias Fase 3
AUTH_DB=auth_db
PRODUCCION_DB=produccion_db
LOGISTICA_DB=logistica_db

# JWT (placeholder - sin valor real, se completará en Fase auth)
JWT_SECRET=change_this_secret_example
JWT_EXPIRES_IN=1h
SESION_INACTIVIDAD_MINUTOS=15

# Administrador inicial (seed:admin). Nunca versionar valores reales.
ADMIN_EMAIL=admin@taller.local
ADMIN_PASSWORD=cambiar_esta_clave_segura
ADMIN_NOMBRE=Administrador

# Flag para pruebas sin PostgreSQL (solo health sin DB). No usar en producción con PG.
SKIP_DB=false

# Google Cloud Pub/Sub - publicación al topic único (ABC-266)
# El JSON real debe quedar fuera del repositorio.
PUBSUB_ENABLED=false
GCP_PROJECT_ID=project-id-de-ejemplo
PUBSUB_TOPIC_ID=topic-id-de-ejemplo
# Recepción ABC-244. La suscripción se provisiona fuera de la aplicación.
PUBSUB_CONSUMER_ENABLED=false
PUBSUB_SUBSCRIPTION_ID=subscription-id-de-ejemplo
# Resultado contable (ABC-252). Usar estos nombres claros solo con PUBSUB_EMULATOR_HOST.
PUBSUB_CONTABILIDAD_CONSUMER_ENABLED=false
PUBSUB_CONTABILIDAD_RESULTADOS_TOPIC_ID=taller-contabilidad-resultados-local
PUBSUB_CONTABILIDAD_RESULTADOS_SUBSCRIPTION_ID=taller-produccion-contabilidad-local
# El cliente oficial detecta el emulador mediante esta variable; dejar vacía fuera de la demo local.
PUBSUB_EMULATOR_HOST=
# Recursos locales del simulador ABC-253.
TALLER_PUBSUB_PROJECT_ID=taller-local
TALLER_CONTABILIDAD_IDA_TOPIC=taller-produccion-cerrada-local
TALLER_CONTABILIDAD_IDA_SUBSCRIPTION=taller-contabilidad-simulator-local
TALLER_CONTABILIDAD_VUELTA_TOPIC=taller-contabilidad-resultados-local
TALLER_CONTABILIDAD_VUELTA_SUBSCRIPTION=taller-produccion-contabilidad-local
CONTABILIDAD_INPUT_SUBSCRIPTION_ID=taller-contabilidad-simulator-local
CONTABILIDAD_OUTPUT_TOPIC_ID=taller-contabilidad-resultados-local
CONTABILIDAD_STATE_PATH=data/state.jsonl
CONTABILIDAD_SIMULATOR_CRASH_AFTER_SAVE_ONCE=false
GCP_CREDENTIALS_HOST_PATH=C:/ruta/segura/pubsub-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=C:/ruta/segura/pubsub-service-account.json
# Publicador durable de eventos pendientes (ABC-242)
OUTBOX_BATCH_SIZE=20
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_LEASE_MS=30000
OUTBOX_RETRY_BASE_MS=5000
OUTBOX_RETRY_MAX_MS=300000
